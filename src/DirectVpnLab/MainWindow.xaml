<Window x:Class="DirectVpnLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Direct VPN Lab"
        Height="860" Width="1200"
        MinHeight="700" MinWidth="1000"
        Background="#FF14171C"
        FlowDirection="LeftToRight"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#14171C"/>
    <SolidColorBrush x:Key="Card" Color="#1C2128"/>
    <SolidColorBrush x:Key="CardAlt" Color="#222831"/>
    <SolidColorBrush x:Key="Accent" Color="#3DB9F5"/>
    <SolidColorBrush x:Key="Green" Color="#2ECC71"/>
    <SolidColorBrush x:Key="Amber" Color="#E6B450"/>
    <SolidColorBrush x:Key="Red" Color="#E85D5D"/>
    <SolidColorBrush x:Key="Muted" Color="#8B949E"/>
    <SolidColorBrush x:Key="Text" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#0D1117"/>
    <SolidColorBrush x:Key="GridLine" Color="#30363D"/>

    <Style TargetType="Button" x:Key="ActionBtn">
      <Setter Property="Background" Value="#2D333B"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#3D444D"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="RowBackground" Value="#161B22"/>
      <Setter Property="AlternatingRowBackground" Value="#1C2128"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="RowHeight" Value="34"/>
      <Setter Property="ColumnHeaderHeight" Value="36"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1F3A4D"/>
          <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="0.38*"/>
    </Grid.RowDefinitions>

    <!-- Header / controls -->
    <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Direct VPN Lab" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
          <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="12">
            <Run Text="Netherlands"/>
            <Run Text="  ·  "/>
            <Run Text="82.23.248.121"/>
            <Run Text="  ·  "/>
            <Run Text="v1.1.4"/>
          </TextBlock>
          <TextBlock x:Name="TxtPersistMeta" Margin="0,4,0,0" Foreground="{StaticResource Muted}" FontSize="11"
                     Text="Results: none saved yet"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ActionBtn}" Content="TEST ALL" Click="TestAll_Click" x:Name="BtnTestAll"/>
          <Button Style="{StaticResource ActionBtn}" Content="CONNECT" Click="Connect_Click" x:Name="BtnConnectTop"/>
          <Button Style="{StaticResource ActionBtn}" Content="DISCONNECT" Click="Disconnect_Click" x:Name="BtnDisconnect" IsEnabled="False"/>
          <Button Style="{StaticResource ActionBtn}" Content="SPEED TEST" Click="SpeedTest_Click" x:Name="BtnSpeed"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Compact status strip -->
    <Border Grid.Row="1" Background="{StaticResource CardAlt}" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="StatusBadge" Background="#30363D" CornerRadius="6" Padding="12,6" Margin="0,0,14,0">
          <TextBlock x:Name="TxtStatus" Text="DISCONNECTED" FontWeight="Bold" FontSize="13"
                     Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </Border>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TxtProtocol" Text="Method: —" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,18,0"/>
          <TextBlock x:Name="TxtExitIp" Text="Exit IP: —" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,18,0"/>
          <TextBlock x:Name="TxtLatency" Text="Latency: —" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,18,0"/>
          <TextBlock x:Name="TxtConnTime" Text="Duration: —" Foreground="{StaticResource Text}" FontSize="13"/>
        </WrapPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TxtSpeedDirect" Text="Direct: —" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0"/>
          <TextBlock x:Name="TxtSpeedVpn" Text="VPN: —" Foreground="{StaticResource Muted}" FontSize="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Success table + details -->
    <Grid Grid.Row="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" Padding="12" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Successful Connection Methods" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}" Margin="2,0,0,8"/>
          <TextBlock DockPanel.Dock="Top" x:Name="TxtSuccessHint" Text="Only PASS methods are listed here."
                     Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,8"/>
          <DataGrid x:Name="GridMethods"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    SelectionMode="Single"
                    FontFamily="Cascadia Mono, Consolas">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="56"/>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="52"/>
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="100"/>
              <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="130"/>
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="64"/>
              <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs, StringFormat={}{0:F0} ms}" Width="88"/>
              <DataGridTextColumn Header="Success" Binding="{Binding SuccessRate, StringFormat={}{0:P0}}" Width="72"/>
              <DataGridTextColumn Header="Quality" Binding="{Binding QualityScore, StringFormat={}{0:F1}}" Width="72"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="12" Padding="12" Margin="8,0,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Other Results" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}" Margin="2,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" Text="Failed / Unverified / Skipped"
                     Foreground="{StaticResource Muted}" FontSize="11" Margin="2,0,0,8"/>
          <DataGrid x:Name="GridOther"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    SelectionMode="Single"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    RowHeight="30">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48"/>
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="140"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="80"/>
              <DataGridTextColumn Header="Detail" Binding="{Binding LastError}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Hidden legacy fields kept for code compatibility -->
    <TextBlock x:Name="TxtTransport" Visibility="Collapsed"/>
    <TextBlock x:Name="TxtServer" Visibility="Collapsed"/>
    <TextBlock x:Name="TxtConnStatus" Visibility="Collapsed"/>
    <Button x:Name="BtnConnect" Visibility="Collapsed"/>

    <!-- Live log -->
    <Border Grid.Row="4" Background="#0D1117" CornerRadius="12" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="Live Log" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True"
                      Foreground="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource ActionBtn}" Content="Copy" Click="CopyLog_Click" Padding="10,4" MinHeight="28"/>
            <Button Style="{StaticResource ActionBtn}" Content="Clear" Click="ClearLog_Click" Padding="10,4" MinHeight="28"/>
            <Button Style="{StaticResource ActionBtn}" Content="Export" Click="ExportLog_Click" Padding="10,4" MinHeight="28"/>
          </StackPanel>
        </Grid>
        <ListBox x:Name="LogList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#C9D1D9"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12.5"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
