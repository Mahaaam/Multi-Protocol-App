<Window x:Class="DirectVpnLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Direct VPN Lab"
        Height="900" Width="1180"
        MinHeight="720" MinWidth="980"
        Background="#FF1A1D21"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#1A1D21"/>
    <SolidColorBrush x:Key="Card" Color="#24282E"/>
    <SolidColorBrush x:Key="Accent" Color="#2EC4FF"/>
    <SolidColorBrush x:Key="Green" Color="#2ECC71"/>
    <SolidColorBrush x:Key="Amber" Color="#F0B429"/>
    <SolidColorBrush x:Key="Red" Color="#E74C3C"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA3AD"/>
    <SolidColorBrush x:Key="Text" Color="#E8EEF4"/>
    <Style TargetType="Button" x:Key="ActionBtn">
      <Setter Property="Background" Value="#2A313A"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#35404C"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.45"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="0.42*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="14" Padding="18" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Direct VPN Lab" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Muted}" FontSize="13">
            <Run Text="Server: Netherlands"/>
            <Run Text="  |  "/>
            <Run Text="Server IP: 82.23.248.121"/>
            <Run Text="  |  "/>
            <Run Text="v1.0.0"/>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight">
          <Button Style="{StaticResource ActionBtn}" Content="TEST ALL" Click="TestAll_Click" x:Name="BtnTestAll"/>
          <Button Style="{StaticResource ActionBtn}" Content="SPEED TEST" Click="SpeedTest_Click" x:Name="BtnSpeed"/>
          <Button Style="{StaticResource ActionBtn}" Content="DISCONNECT" Click="Disconnect_Click" x:Name="BtnDisconnect" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Connect panel -->
      <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="14" Padding="18" Margin="0,0,12,12">
        <StackPanel>
          <TextBlock Text="اتصال" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,12"/>
          <Button x:Name="BtnConnect" Click="Connect_Click" Width="180" Height="180" Cursor="Hand" HorizontalAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Grid>
                  <Ellipse x:Name="Ring" Width="180" Height="180" StrokeThickness="6" Stroke="#3A4450" Fill="#1E2329"/>
                  <TextBlock x:Name="Label" Text="CONNECT" Foreground="{StaticResource Text}" FontSize="18" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                </Grid>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <TextBlock x:Name="TxtStatus" Text="Disconnected" HorizontalAlignment="Center" Margin="0,16,0,0"
                     Foreground="{StaticResource Muted}" FontSize="16" FlowDirection="LeftToRight"/>

          <Border Background="#1E2329" CornerRadius="10" Padding="12" Margin="0,18,0,0" FlowDirection="LeftToRight">
            <StackPanel>
              <TextBlock Text="Connection Info" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="TxtProtocol" Text="Protocol: —" Foreground="{StaticResource Text}" Margin="0,2"/>
              <TextBlock x:Name="TxtTransport" Text="Transport: —" Foreground="{StaticResource Text}" Margin="0,2"/>
              <TextBlock x:Name="TxtServer" Text="Server: 82.23.248.121" Foreground="{StaticResource Text}" Margin="0,2"/>
              <TextBlock x:Name="TxtExitIp" Text="Exit IP: —" Foreground="{StaticResource Text}" Margin="0,2"/>
              <TextBlock x:Name="TxtLatency" Text="Latency: —" Foreground="{StaticResource Text}" Margin="0,2"/>
              <TextBlock x:Name="TxtConnTime" Text="Connection Time: —" Foreground="{StaticResource Text}" Margin="0,2"/>
              <TextBlock x:Name="TxtConnStatus" Text="Status: Disconnected" Foreground="{StaticResource Text}" Margin="0,2"/>
            </StackPanel>
          </Border>

          <Border Background="#1E2329" CornerRadius="10" Padding="12" Margin="0,12,0,0" FlowDirection="LeftToRight">
            <StackPanel>
              <TextBlock Text="Speed Test" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock x:Name="TxtSpeedDirect" Text="DIRECT: —" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
              <TextBlock x:Name="TxtSpeedVpn" Text="VPN: —" Foreground="{StaticResource Text}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Successful methods -->
      <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="14" Padding="14" Margin="0,0,0,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Successful Connection Methods" FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource Text}" Margin="4,0,0,10" FlowDirection="LeftToRight"/>
          <DataGrid x:Name="GridMethods"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    Background="Transparent"
                    Foreground="{StaticResource Text}"
                    BorderThickness="0"
                    RowBackground="#1E2329"
                    AlternatingRowBackground="#222830"
                    FlowDirection="LeftToRight"
                    FontFamily="Cascadia Mono, Consolas">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="60"/>
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="110"/>
              <DataGridTextColumn Header="Transport" Binding="{Binding Transport}" Width="140"/>
              <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="70"/>
              <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs, StringFormat={}{0:F0} ms}" Width="90"/>
              <DataGridTextColumn Header="Success Rate" Binding="{Binding SuccessRate, StringFormat={}{0:P0}}" Width="100"/>
              <DataGridTextColumn Header="Quality" Binding="{Binding QualityScore, StringFormat={}{0:F1}}" Width="80"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Live log -->
    <Border Grid.Row="2" Background="#0E1013" CornerRadius="14" Padding="12">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
          <TextBlock Text="Live Connection Log" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
            <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/>
            <Button Style="{StaticResource ActionBtn}" Content="Copy" Click="CopyLog_Click" Padding="10,4"/>
            <Button Style="{StaticResource ActionBtn}" Content="Clear" Click="ClearLog_Click" Padding="10,4"/>
            <Button Style="{StaticResource ActionBtn}" Content="Export" Click="ExportLog_Click" Padding="10,4"/>
          </StackPanel>
        </Grid>
        <ListBox x:Name="LogList"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="#D7DEE7"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12.5"
                 FlowDirection="LeftToRight"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
