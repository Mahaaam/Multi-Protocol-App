<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon />
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DirectVpnLab</AssemblyName>
    <Product>Direct VPN Lab</Product>
    <Version>1.1.9</Version>
    <InformationalVersion>1.1.9</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\sing-box\sing-box.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\sing-box\sing-box.exe</TargetPath>
    </None>
    <None Include="Assets\sing-box\wintun.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\sing-box\wintun.dll</TargetPath>
    </None>
    <None Include="Assets\sing-box\libcronet.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\sing-box\libcronet.dll</TargetPath>
    </None>
    <None Include="Assets\certs\ca.crt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\certs\ca.crt</TargetPath>
    </None>
    <None Include="Assets\certs\credentials.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\certs\credentials.json</TargetPath>
    </None>
    <None Include="Assets\certs\client.crt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\certs\client.crt</TargetPath>
    </None>
    <None Include="Assets\certs\client.key">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Assets\certs\client.key</TargetPath>
    </None>
  </ItemGroup>

</Project>
